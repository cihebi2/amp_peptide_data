      "owner_worker": "worker-2",
      "target_queue": "analysis",
      "severity": "blocking",
      "created_at": "2026-07-27T12:16:48.857590Z",
      "reason": "Layer-2 final activity/toxicity evidence is not source-complete or locator-faithful. Table 1 has many source MIC observations, including 14 non-slash Dap values and 17 YZ462 values, but the final keeps only two daptomycin rows and inverts row_label/column_label. The same final omits source-reported toxicity/selectivity values from xml:p:33."
    },
    "rwk-PMC12606902-campaign-r01-worker5-mechanism-entity-conflation": {
      "owner_worker": "worker-5",
      "target_queue": "mechanism",
      "severity": "blocking",
      "created_at": "2026-07-27T12:16:48.861913Z",
      "reason": "The final mechanism ontology assigns YZ462 source-located mechanism evidence to daptomycin. Direct membrane disruption, membrane-potential, SEM, ITC, ROS, and biofilm locators cited in the final all describe YZ462 treatment in the primary source, not daptomycin mechanism assays."
    },
    "rwk-PMC12606902-campaign-r01-worker4-placeholder-sequence-length-mismatch": {
      "owner_worker": "worker-4",
      "target_queue": "database",
      "severity": "blocking",
      "created_at": "2026-07-27T12:16:48.866414Z",
      "reason": "Final database verification contains placeholder-like sequence='None' with sequence_length=4 in multiple candidate objects. Independent residue counting does not support length 4 for a plain one-letter peptide sequence, and the primary source provides no source-located daptomycin sequence/modification identity for these fallback rows."
    },
    "rwk-PMC12606902-campaign-r01-worker3-supplementary-surface-not-exhausted": {
