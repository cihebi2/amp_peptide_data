{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batch4.local/schemas/workflow_event.schema.json",
  "title": "Miaobi Workflow Event",
  "type": "object",
  "required": ["record_type", "workflow_id", "paper_id", "event", "created_at"],
  "additionalProperties": true,
  "properties": {
    "record_type": { "const": "workflow_event" },
    "workflow_id": { "type": "string" },
    "paper_id": { "type": "string" },
    "state": { "type": "string" },
    "event": {
      "type": "string",
      "enum": [
        "workflow_initialized",
        "state_started",
        "state_completed",
        "state_failed",
        "state_blocked",
        "artifact_created",
        "artifact_updated",
        "rework_opened",
        "rework_closed",
        "gate_passed",
        "gate_failed",
        "workflow_completed",
        "workflow_blocked"
      ]
    },
    "payload": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
